{
  "schema_version": "otr_story_lab.ledger_requirements.v1",
  "artifact_boundary": {
    "output": "validated_ledger_envelope_json",
    "ledger_only": true,
    "required_planes": [
      "story_ledger",
      "story_seal"
    ],
    "story_lab_null_planes": [
      "production_state",
      "final_seal"
    ],
    "excluded_outputs": [
      "speech",
      "audio_mix",
      "image",
      "video",
      "obs_publish"
    ]
  },
  "minimum_ship_contract": {
    "ledger_integrity": {
      "required": true,
      "outcome": "The ledger validates, freezes atomically, and preserves required rows plus all graph, cast, source, speaker, fact, and music references."
    },
    "news_capture": {
      "required": true,
      "outcome": "The selected source packet, provenance, and usable factual claims are present before fictional dialogue is authored."
    },
    "announcer_open": {
      "required": true,
      "position": "first_spoken_row",
      "outcome": "The announcer introduces the story, setting, and characters."
    },
    "announcer_news_coda": {
      "required": true,
      "position": "last_spoken_row",
      "minimum_source_fact_refs": 1,
      "outcome": "The announcer closes by summarizing the real news from captured evidence after the fictional drama."
    },
    "music_bookends": {
      "required": true,
      "first_sequence_role": "music_open",
      "last_sequence_role": "music_close",
      "outcome": "The ledger declares opening music first and closing music last."
    }
  },
  "row_contract": {
    "allowed_sequence_roles": [
      "music_open",
      "announcer_open",
      "character_dialogue",
      "music_inter",
      "announcer_news_coda",
      "music_close"
    ],
    "allowed_spoken_roles": [
      "announcer_open",
      "character_dialogue",
      "announcer_news_coda"
    ],
    "music_inter_is_optional_and_script_requested": true,
    "forbidden_sequence_roles": [
      "action",
      "stage_direction"
    ],
    "forbidden_spoken_content": [
      "action",
      "stage_direction",
      "third_person_narration",
      "delivery_note"
    ],
    "routing_role_axis": [
      "announcer",
      "character"
    ],
    "sequence_role_is_not_speaker_role": true,
    "every_spoken_line_requires_score_owned_speaker_name": true,
    "every_spoken_line_requires_fact_ids_field": true
  },
  "freeze_semantics": {
    "draft_mutation_allowed_before_validation": true,
    "freeze_requires_full_contract_validation": true,
    "freeze_is_atomic": true,
    "story_ledger_requires_canonical_sha256": true,
    "story_seal_requires_trusted_receipt_registry": true,
    "story_ledger_post_acceptance_mutation": "forbidden",
    "production_state_post_acceptance_mutation": "phase_owned_append_only",
    "current_executable_non_null_production_or_final_plane": "rejected_until_strict_schemas_land",
    "final_seal_after": "publication_and_audit",
    "post_final_seal_mutation": "forbidden",
    "contract_change": "new_schema_version_and_explicit_migration",
    "current_l4_cleanup_locked_is_not_enforcement": true
  },
  "episode_length_tier": {
    "field": "episode_length_tier",
    "values_in_ui_order": [
      "ultra_short",
      "medium",
      "long",
      "extra_long"
    ],
    "resolution_authority": "versioned_bank_length_plan",
    "generation_method": "compiler_owned_movements_and_bounded_row_chunks",
    "model_receives_resolved_chunk_not_length_label": true,
    "words_are_telemetry_only": true,
    "duration_is_downstream_observation_only": true,
    "unknown_or_missing_mapping": "fail_before_model_call"
  },
  "explicitly_experimental": [
    "model_or_provider",
    "prompt_wording",
    "number_of_passes",
    "movement_count_per_tier",
    "scene_count_per_tier",
    "turn_count_per_tier",
    "chunk_size",
    "approximate_minutes_per_tier",
    "bank_specific_length_mapping"
  ]
}
